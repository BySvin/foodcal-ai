rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{uid} — account + profile + onboarding results. Owner-only.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && request.resource.data.onboardingCompleted == false;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // settings/{uid} — app-level preferences (theme, notifications flag).
    // Owner-only, doc id must match the caller's uid.
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Collections introduced in later milestones (foods, food_logs,
    // favorites, water_logs, weight_logs) are added here incrementally as
    // each feature is built, alongside their own rules-unit tests.
  }
}

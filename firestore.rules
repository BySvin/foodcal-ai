rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{uid} — account + profile + onboarding results. Owner-only.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && request.resource.data.onboardingCompleted == false;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // settings/{uid} — app-level preferences (theme, notifications flag).
    // Owner-only, doc id must match the caller's uid.
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // foods/{foodId} — shared catalog: seeded entries (isCustom: false,
    // createdBy: null, written only by the Admin SDK seed script which
    // bypasses these rules) plus user-submitted custom foods (M5).
    // Every signed-in user can read the whole catalog; a client can only
    // ever create/update/delete its OWN custom entries, never a seeded one.
    match /foods/{foodId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.isCustom == true
        && request.resource.data.createdBy == request.auth.uid;
      // Both the existing doc AND the incoming write must stay a custom
      // food owned by the caller — otherwise an owner could flip isCustom
      // to false or reassign createdBy on update, laundering a custom
      // entry into looking like a seeded catalog item.
      allow update: if isSignedIn()
        && resource.data.isCustom == true
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.isCustom == true
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.isCustom == true
        && resource.data.createdBy == request.auth.uid;
    }

    // food_logs/{logId} — owner-only. Random doc id (auto-generated on
    // create), so ownership is enforced purely via the userId field.
    match /food_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.calories is number
        && request.resource.data.calories >= 0
        && request.resource.data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'];
      // Quantity edits go through update — re-validate the same invariants
      // so an edit can't reassign ownership or write bad data.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.calories is number
        && request.resource.data.calories >= 0
        && request.resource.data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'];
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // favorites/{uid}_{foodId} — owner-only, deterministic doc id enforced
    // at the rules layer (not just app convention) to prevent a client
    // from writing another user's favorite under a spoofed id.
    match /favorites/{favoriteId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.foodId;
      // addFavorite() calls a plain (non-merge) set(), which Firestore
      // evaluates as `update` when the doc already exists — e.g.
      // re-favoriting an already-favorited food. Without this, that write
      // is denied in production even though it passes against
      // fake_cloud_firestore, which doesn't enforce rules at all.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.foodId;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // water_logs/{uid}_{date} — one aggregate doc per user per day.
    // Owner-only, deterministic doc id enforced at the rules layer. Quick
    // adds use a merge-set with FieldValue.increment, which Firestore
    // resolves to a plain number before these rules run, so totalMl is
    // always validated as the final numeric value either way.
    match /water_logs/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.totalMl is number
        && request.resource.data.totalMl >= 0;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.totalMl is number
        && request.resource.data.totalMl >= 0;
      allow delete: if false;
    }

    // weight_logs/{uid}_{loggedDate} — one entry per user per day.
    // Owner-only, deterministic doc id. logWeight() writes a full set()
    // (no merge), so create and update see the same full-document shape.
    match /weight_logs/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.loggedDate
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.weightKg < 500;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.loggedDate
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.weightKg < 500;
      allow delete: if false;
    }
  }
}
